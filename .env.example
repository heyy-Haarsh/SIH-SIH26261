# PRAMAN environment configuration — placeholders only
# Copy to .env and fill values for local development.

# Application
APP_NAME=PRAMAN
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# Database — PostgreSQL (intended primary)
# DATABASE_URL=postgresql+psycopg://praman:praman@localhost:5432/praman
# Development-only SQLite fallback (not for production)
DATABASE_URL=sqlite:///./praman_dev.db
USE_SQLITE_FALLBACK=true

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo auth (NOT secure — development only)
DEMO_AUTH_ENABLED=true

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,docx,txt

# Phase 7 geocoding (public Nominatim — off by default; respect usage policy)
ENABLE_NOMINATIM_GEOCODE=false
NOMINATIM_USER_AGENT=PRAMAN-SIH26261/0.1 (local-dev; contact=admin@praman.local)
GEOCODE_MISMATCH_METERS=5000

# Object storage (optional — local filesystem adapter used by default)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=praman-documents
STORAGE_BACKEND=local

# Async jobs (optional — sync/local adapter used by default)
REDIS_URL=
CELERY_BROKER_URL=
USE_CELERY=false

# External AI / LLM (optional — does NOT disable local PDF/OCR)
# LLM_PROVIDER=gemini|openai|none — none = OCR+regex only, no API key required
LLM_API_KEY=
LLM_PROVIDER=none
LLM_MODEL=
ENABLE_AI_EXTRACTION=false

# Officer-note speech-to-text (Sarvam). Key stays on the API server — never put it in VITE_*.
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v4
SARVAM_REALTIME_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_REALTIME_MODEL=saaras:v3-realtime

# Local document intelligence
ENABLE_LOCAL_PDF_EXTRACTION=true
ENABLE_LOCAL_OCR=true
# Marathi needs tessdata "mar" (and "hin" for Devanagari Hindi); missing packs degrade to what is installed.
OCR_LANGUAGES=eng+hin+mar
OCR_DPI=200
MAX_EXTRACTION_PAGES=50
EXTRACTION_TIMEOUT_SECONDS=120
AUTO_EXTRACT_ON_UPLOAD=true

# External verification (optional — mock adapters used by default)
AICTE_API_BASE_URL=
AICTE_API_KEY=
ENABLE_LIVE_VERIFICATION=false

# Simulated issuer service (Phase 2) — default port 8001; busy port fails loudly
# Set USE_SIMULATED_HTTP_ISSUERS=true after starting: python -m simulated_issuers.main
# pyHanko trust roots folder (empty = chain_untrusted_no_trust_store). Do not invent certs.
TRUST_STORE_DIR=

USE_SIMULATED_HTTP_ISSUERS=false
SIMULATED_ISSUERS_URL=http://127.0.0.1:8001
SIMULATED_ISSUERS_PORT=8001
FIRE_ISSUER_BASE_URL=http://127.0.0.1:8001
BUILDING_ISSUER_BASE_URL=http://127.0.0.1:8001
STRUCTURAL_ISSUER_BASE_URL=http://127.0.0.1:8001
AICTE_PAYMENT_ISSUER_BASE_URL=http://127.0.0.1:8001
ICAI_ISSUER_BASE_URL=http://127.0.0.1:8001
ESTAMP_ISSUER_BASE_URL=http://127.0.0.1:8001
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
# Home page “View video prototype” button (YouTube, Drive, Loom, …)
# VITE_PROTOTYPE_VIDEO_URL=https://www.youtube.com/watch?v=

